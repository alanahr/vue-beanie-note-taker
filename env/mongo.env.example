# MongoDB environment configuration
# Copy this file to env/mongo.env and adjust values as needed

# Primary data MongoDB credentials
MONGO_DATA_ROOT_USERNAME=root
MONGO_DATA_ROOT_PASSWORD=example
MONGO_DATA_PORT=27017

# RAG MongoDB credentials
MONGO_RAG_ROOT_USERNAME=root
MONGO_RAG_ROOT_PASSWORD=example
MONGO_RAG_PORT=27018
