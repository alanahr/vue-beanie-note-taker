# Server (FastAPI + Beanie) environment configuration
# Copy this file to env/server.env and adjust values as needed

# Primary MongoDB connection (data storage)
MONGO_DATA_URL=mongodb://root:example@mongo-data:27017/
MONGO_DATA_DB=tiptap_editor

# RAG MongoDB connection (vector search)
MONGO_RAG_URL=mongodb://root:example@mongo-rag:27017/
MONGO_RAG_DB=tiptap_rag

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8002

# Embedding model for vector search (Hugging Face model id)
EMBEDDING_MODEL_NAME=MongoDB/mdbr-leaf-ir

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
